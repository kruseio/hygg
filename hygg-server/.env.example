# hygg-server configuration. Copy to `.env` (autoloaded on startup) and edit.
# Every value here has a sensible default; nothing is required to boot.

# --- Core ---
# Path to the SQLite database file.
# All server state lives under the project's ./data tree.
DATABASE_URL=sqlite://data/hygg-server.db
# Port the server listens on. Change this to move it off 3032.
PORT=3032
# Interface to bind: 0.0.0.0 = all interfaces (reachable on your LAN),
# 127.0.0.1 = this machine only.
HOST=0.0.0.0
# Advanced: a full host:port that overrides HOST/PORT when set.
# BIND_ADDR=0.0.0.0:3032
RUST_LOG=hygg_server=info,tower_http=info
# Base directory for rotating log files. The server writes to
# <LOG_DIR>/hygg-server/, rotated daily and retained for 30 days.
LOG_DIR=data/logs

# --- Sessions / web UI ---
# Reserved for signed-cookie deployments. Current sessions are random opaque
# DB-backed ids, but keep this set for forward-compatible production configs.
SESSION_SECRET=
# WebAuthn / passkeys relying-party config. RP_ID is the registrable domain.
# Full passkey ceremonies are planned; passkey rows can already be revoked.
RP_ID=localhost
RP_ORIGIN=http://localhost:3032
RP_NAME=hygg

# --- Browser PWA (hygg-pwa) ---
# Public URL of the browser reader, linked from the landing page ("Open the
# app") so visitors can start reading in their browser.
PWA_URL=https://pwa.hygg.kruseio.com
# Exact origins allowed to call the JSON API cross-origin (the PWA runs on a
# separate origin and uses bearer tokens). Comma-separated. When unset, the
# self-host default is "*" — any origin — so a PWA served from any LAN address
# (e.g. http://<lan-ip>:8080) reaches the server out of the box; this is safe
# because the API is bearer-authenticated with no cookies. Set this explicitly
# to lock a deployment down.
# CORS_ALLOW_ORIGINS=https://pwa.hygg.kruseio.com,http://127.0.0.1:8080

# --- Password hashing (Argon2id) ---
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# --- Storage ---
# Where uploaded document blobs are stored (filesystem-backed by default).
BLOB_DIR=data/blobs
# Maximum accepted request body size in bytes (caps blob uploads). 128 MiB.
MAX_BODY_BYTES=134217728
# Cache and reuse server-side document extraction. When on (default), an
# expensive OCR/pandoc conversion runs once per (document, width) and is reused
# by every later client import; the server also pre-warms the cache in the
# background when a document's bytes are uploaded, so thin clients can read
# canonical text without re-extracting. Set to false to disable the cache
# entirely (every /convert re-runs the pipeline) — a kill switch if it
# misbehaves. Cached rows are derived data and are not billed against storage
# quotas.
HYGG_EXTRACTION_CACHE=true

# --- First-run admin bootstrap ---
# When the database is empty, an initial admin user is created from these.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
