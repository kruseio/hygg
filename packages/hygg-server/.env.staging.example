# Staging deployment config. Copy to `.env.staging` and adjust, then bring the
# stack up with (always pass --env-file, see compose.staging.yml):
#
#   docker compose -f compose.staging.yml --env-file .env.staging up --build -d
#
# Staging runs beside prod from the same clone: different project name,
# different port, its own database in ./hygg-data-staging. Only the values that
# have to differ from prod are listed here; everything else falls back to the
# image defaults. See .env.example for the full set.

# Published (and in-container) app port — must differ from prod's.
PORT=3033

# --- Public identity (set these for a real staging deployment) -----------------
# RP_ID must be the domain the browser actually sees, or the passkey ceremonies
# reject: a staging host needs its own, not prod's.
# RP_ID=staging.hygg.example.com
# RP_ORIGIN=https://staging.hygg.example.com
# RP_NAME=hygg (staging)
# PWA_URL=https://pwa.staging.hygg.example.com
# CORS_ALLOW_ORIGINS=https://pwa.staging.hygg.example.com

# --- First-run admin bootstrap -------------------------------------------------
# Created on an empty database, so staging is reachable without a prod account.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- Optional knobs ------------------------------------------------------------
# Staging is where you want the noisy logs.
# RUST_LOG=hygg_server=debug,tower_http=debug
