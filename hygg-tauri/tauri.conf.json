{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hygg",
  "identifier": "com.kruseio.hygg",
  "build": {
    "frontendDist": "../hygg-pwa/dist",
    "beforeBuildCommand": "cd hygg-pwa && trunk build --release",
    "beforeDevCommand": "cd hygg-pwa && trunk serve",
    "devUrl": "http://127.0.0.1:8080"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "hygg",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
