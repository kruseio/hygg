# hygg-server runtime state. `hygg-data` is the current name (specific enough
# not to collide with a directory that was already there); the prod and staging
# compose stacks each bind-mount their own. Both are created next to the compose
# file, or at the repo root when the server is run from there instead
# (e.g. `cargo run -p hygg-server`).
packages/hygg-server/hygg-data/
packages/hygg-server/hygg-data-staging/
/hygg-data/
# `data` was the name before it, kept ignored because deployments that predate
# the rename still point at one and there is no automatic move.
packages/hygg-server/data/
/data/
# Real deployment configs live only on the machine that runs them; the
# .example templates beside them are what's committed.
packages/hygg-server/.env
packages/hygg-server/.env.staging
test-upload.txt
AGENTS.md
.DS_Store

# hygg-pwa: Trunk build output + Playwright MCP scratch (screenshots/fixtures)
packages/hygg-pwa/dist/
.playwright-mcp/
packages/hygg-pwa/.env

# The TTS model + voices are distributed as release assets (too large for the
# repo, and LFS bandwidth is metered), downloaded at runtime and verified by
# SHA-256 — see cli-text-reader speech/kokoro/files.rs. This is only a local
# staging spot for uploading them to a release; the bytes never belong in git.
/assets/tts/
